# ==============================================================================
# Lunhaw Environment Variables Template
# Copy this file to .env.local to configure your local development environment.
# Never commit .env, .env.local, or actual secret keys to version control!
# ==============================================================================

# Supabase Public Configuration (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-side (Optional, for backend scripts/admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
