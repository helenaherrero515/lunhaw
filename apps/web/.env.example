# ==============================================================================
# Lunhaw web: environment variables (copy to .env.local)
# Values are baked into the static build, so only put PUBLIC values here.
# Never put the Supabase service-role key in any NEXT_PUBLIC_ variable.
# ==============================================================================

# Lunhaw API (apps/api). Locally: `pnpm --filter @lunhaw/api dev`. Production: your workers.dev URL.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase (accounts). Leave unset locally to use the development-only mock sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
